---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPhotos } from '../lib/photos';
import { getFirstImage, getAutoExcerpt } from '../lib/postExcerpt';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).map((post) => ({
  type: 'post' as const,
  date: post.data.date,
  post,
  image: getFirstImage(post.body ?? ''),
  excerpt: post.data.description ?? getAutoExcerpt(post.body ?? ''),
}));

// Cap how many photo entries appear in the home feed
const PHOTO_LIMIT = 20;

const photos = (await getPhotos())
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, PHOTO_LIMIT)
  .map((photo) => ({
    type: 'photo' as const,
    date: photo.date,
    photo,
  }));

const items = [...posts, ...photos].sort((a, b) => b.date.getTime() - a.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base description="Long Walk Home — writing and photos by Ryan Hoffman">
  <div class="feed-filter" data-active="all">
    <div class="slider-thumb"></div>
    <button type="button" class="filter-btn" data-filter="posts" aria-pressed="false">Posts</button>
    <button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">Posts + Pics</button>
  </div>
  <ul class="feed">
    {
      items.map((item) =>
        item.type === 'post' ? (
          <li class="feed-item post-item">
            {item.image && (
              <a class="post-thumb" href={`/posts/${item.post.id}/`} tabindex="-1">
                <img src={item.image} alt="" loading="lazy" />
              </a>
            )}
            <div class="meta">{fmt(item.date)}</div>
            <h2>
              <a href={`/posts/${item.post.id}/`}>{item.post.data.title}</a>
            </h2>
            {item.excerpt && <p class="excerpt">{item.excerpt}</p>}
            <a class="read-more" href={`/posts/${item.post.id}/`}>Read more →</a>
          </li>
        ) : (
          <li class="feed-item photo-item">
            <div class="meta">
              {fmt(item.date)} · <a href={item.photo.link}>Photo{item.photo.album ? ` · ${item.photo.album}` : ''}</a>
            </div>
            {item.photo.image && (
              <a class="photo-link" href={item.photo.link}>
                <img src={item.photo.image} alt={item.photo.title} loading="lazy" />
              </a>
            )}
          </li>
        )
      )
    }
  </ul>
  {items.length === 0 && <p>Nothing here yet.</p>}
</Base>

<script>
  const STORAGE_KEY = 'lwh-feed-filter';
  const filterEl = document.querySelector<HTMLElement>('.feed-filter');
  const feed = document.querySelector<HTMLElement>('.feed');

  if (filterEl && feed) {
    const buttons = filterEl.querySelectorAll<HTMLButtonElement>('.filter-btn');

    const applyFilter = (filter: string) => {
      feed.classList.toggle('filter-posts-only', filter === 'posts');
      filterEl.dataset.active = filter;
      buttons.forEach((btn) => {
        const active = btn.dataset.filter === filter;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
    };

    const saved = localStorage.getItem(STORAGE_KEY);
    applyFilter(saved === 'posts' ? 'posts' : 'all');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'all';
        applyFilter(filter);
        localStorage.setItem(STORAGE_KEY, filter);
      });
    });
  }
</script>
